modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"
packages = ["unzip"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && npm start > /tmp/studytrack-backend.log 2>&1 & cd client && exec ./node_modules/.bin/vite --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "cd server && npm start > /tmp/studytrack-backend.log 2>&1 & cd client && exec npm run preview -- --host 0.0.0.0 --port 5000"]
build = ["sh", "-c", "cd client && npm run build"]
