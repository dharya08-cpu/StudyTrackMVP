PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-in-production
DB_PATH=studytrack.db
STUDYTRACK_TIMEZONE=Asia/Kolkata
# CLIENT_ORIGIN is only needed when the frontend is hosted on a different origin.
# CLIENT_ORIGIN=http://localhost:5173
# Only needed when starting a brand-new production database without an existing teacher.
# INITIAL_TEACHER_EMAIL=teacher@coaching.com
# INITIAL_TEACHER_PASSWORD=use-a-strong-12+character-password
# INITIAL_TEACHER_NAME=StudyTrack Teacher
# INITIAL_CLASS_CODE=DEMO01
# INITIAL_CLASS_NAME=Demo Class
# INITIAL_STUDENT_PASSWORD=optional-strong-12+character-password
