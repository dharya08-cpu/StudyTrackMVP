# Copy to server/.env for local development. In production set these in the Render dashboard instead.
NODE_ENV=development
PORT=3001

# --- Database: PostgreSQL (Supabase -> Project Settings -> Database -> Connection string; use the pooler string on Render) ---
DATABASE_URL=postgresql://postgres.xxxx:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# disable | require (encrypted, default in production) | verify (also checks the certificate; set DATABASE_CA_CERT)
DATABASE_SSL=require
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DB_POOL_MAX=10

# --- Secrets (production refuses to start without strong values) ---
# Random string, at least 32 characters. Signs CSRF tokens and owner-admin sessions. Generate: openssl rand -hex 32
SESSION_SECRET=
# Owner admin panel key (/admin), at least 12 characters
ADMIN_KEY=

# --- Google sign-in (the ONLY way to log in) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# --- Public address(es) of this app. Used for CSRF/origin checks. Comma separated, https in production ---
APP_URL=http://localhost:5000
# Only if the front end is hosted on a different domain from the API:
# CLIENT_ORIGIN=https://app.example.com
# Number of proxies in front of the server (Render = 1). Needed so rate limits see the real client address.
TRUST_PROXY=0

# --- Supabase Storage (PRIVATE buckets) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=studytrack-files
SUPABASE_BACKUP_BUCKET=studytrack-backups

# --- Uploads and sessions ---
MAX_UPLOAD_MB=15
SESSION_MAX_DAYS=30
SESSION_IDLE_DAYS=14
MAX_SESSIONS_PER_USER=10
TEACHER_SIGNUP_LIMIT=20

# --- Backups ---
BACKUP_ENABLED=false
BACKUP_DAILY_KEEP=14
BACKUP_WEEKLY_KEEP=8
# 0 = Sunday ... 6 = Saturday (the weekly backup and its automatic restore test)
BACKUP_WEEKLY_DAY=0

STUDYTRACK_TIMEZONE=Asia/Kolkata
