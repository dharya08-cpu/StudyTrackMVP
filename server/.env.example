PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-in-production
# ADMIN_KEY opens the owner admin panel at /admin. Use 12+ random characters in production.
ADMIN_KEY=change-this-in-production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=studytrack-files
DB_PATH=studytrack.db
STUDYTRACK_TIMEZONE=Asia/Kolkata
# CLIENT_ORIGIN is only needed when the frontend is hosted on a different origin.
# CLIENT_ORIGIN=http://localhost:5173
# Render (and most hosts) put one proxy in front of the app, which is the production default.
# Set TRUST_PROXY=0 if you expose Node directly to the internet, or the number of proxies in front of it.
# TRUST_PROXY=1
# How many teacher sign-ups / institute requests one IP may make per hour (default 20).
# TEACHER_SIGNUP_LIMIT=20
# Optional: seed a demo teacher on a brand-new production database. Teachers can otherwise
# sign up themselves in the app, so a fresh database may start empty.
# INITIAL_TEACHER_EMAIL=teacher@coaching.com
# INITIAL_TEACHER_PASSWORD=use-a-strong-12+character-password
# INITIAL_TEACHER_NAME=StudyTrack Teacher
# INITIAL_CLASS_CODE=DEMO01
# INITIAL_CLASS_NAME=Demo Class
# INITIAL_STUDENT_PASSWORD=optional-strong-12+character-password
